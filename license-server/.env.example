GPTLOCK_LICENSE_HOST=127.0.0.1
GPTLOCK_LICENSE_PORT=3188
GPTLOCK_LICENSE_DB=./data/gptlock-license.sqlite3
GPTLOCK_LICENSE_PUBLIC_ORIGIN=https://gptlock.mv3.cn
GPTLOCK_LICENSE_ADMIN_PASSWORD=replace-with-a-long-random-password
GPTLOCK_LICENSE_SECRET=replace-with-at-least-32-random-bytes
GPTLOCK_LICENSE_WINDOW_TTL_SECONDS=150
GPTLOCK_LICENSE_ADMIN_SESSION_HOURS=12

# Server-side GitHub updater. The systemd installer uses these values.
GPTLOCK_UPDATE_REF=main
# GPTLOCK_UPDATE_REPO_DIR=/www/wwwroot/gptlock-license-repo
# GPTLOCK_UPDATE_DATA_DIR=/var/lib/gptlock-license
# GPTLOCK_UPDATE_NODE_BIN=/usr/local/bin/node22
# GPTLOCK_UPDATE_SERVICE=gptlock-license.service
