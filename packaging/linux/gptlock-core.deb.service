[Unit]
Description=GPTLock 本地验证 API / GPTLock Local Verification API
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/gptlock-core serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
UMask=0077
LockPersonality=true

[Install]
WantedBy=default.target
