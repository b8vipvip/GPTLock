{
  "manifest_version": 3,
  "name": "GPTLock",
  "version": "0.5.31",
  "description": "ChatGPT 正式聊天请求模型锁定与响应证据确认 / Formal chat request locking and evidence-based response verification.",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": [
    "alarms",
    "debugger",
    "downloads",
    "nativeMessaging",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gptlock.mv3.cn/*"
  ],
  "background": {
    "service_worker": "background-entry.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "page-model-evidence.js",
        "context-budget.js",
        "private-context-budget-authority.js",
        "content.js",
        "model-catalog.js",
        "model-auto-lock.js",
        "chat-length-remaining-indicator.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "settings-v0521.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "GPTLock",
    "default_popup": "popup-v0513.html"
  }
}
