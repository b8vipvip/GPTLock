{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptlock.invalid/contracts/private-engine-bundle.schema.json",
  "title": "GPTLock Private Engine Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "productVersion",
    "engineVersion",
    "platform",
    "architecture",
    "fileName",
    "sha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolVersion": { "const": 2 },
    "productVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "engineVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "platform": { "enum": ["linux", "windows"] },
    "architecture": { "const": "x64" },
    "fileName": { "type": "string", "pattern": "^gptlock-engine(?:\\.exe)?$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
